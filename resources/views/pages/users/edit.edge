@usersLayout()
  <a class="back" href="/users/{{ user.id }}">‹ Detail</a>
  <div class="head">
    <h1>Upravit uživatele</h1>
  </div>

  <form method="POST" action="/users/{{ user.id }}">
    {{ csrfField() }}

    <div class="group">
      <div class="field">
        <label for="fullName">Jméno</label>
        <input id="fullName" name="fullName" value="{{ flashMessages.get('fullName', user.fullName) }}">
      </div>
      @inputError('fullName')
        @each(message in $messages)
          <div class="err">{{ message }}</div>
        @end
      @end

      <div class="field">
        <label for="email">E-mail</label>
        <input id="email" name="email" type="email" value="{{ flashMessages.get('email', user.email) }}">
      </div>
      @inputError('email')
        @each(message in $messages)
          <div class="err">{{ message }}</div>
        @end
      @end
    </div>

    <div class="group gap">
      <div class="field">
        <label for="password">Nové heslo</label>
        <input id="password" name="password" type="password" autocomplete="new-password" placeholder="Beze změny">
      </div>
      @inputError('password')
        @each(message in $messages)
          <div class="err">{{ message }}</div>
        @end
      @end

      <div class="field">
        <label for="password_confirmation">Heslo znovu</label>
        <input id="password_confirmation" name="password_confirmation" type="password" autocomplete="new-password">
      </div>
      @inputError('password_confirmation')
        @each(message in $messages)
          <div class="err">{{ message }}</div>
        @end
      @end
    </div>
    <p class="foot">Pole s heslem nech prázdná, pokud ho nechceš měnit.</p>

    <div class="stack">
      <button class="btn btn-primary btn-block" type="submit">Uložit změny</button>
      <a class="btn btn-block" href="/users/{{ user.id }}">Zrušit</a>
    </div>
  </form>
@end
